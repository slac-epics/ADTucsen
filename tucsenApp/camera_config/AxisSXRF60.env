#
# ----- AXIS-SXRF-60 ENV Vars -----
#
epicsEnvSet( "IMAGE_FTVL",			"SHORT"		)
epicsEnvSet( "IMAGE_TYPE",			"Int16"		)
epicsEnvSet( "IMAGE_BIT_DEPTH",	        	"16"		)	# 11 fps@16-bit HDR, 26 fps@12-bit STD, 8 fps@14-bit STD
epicsEnvSet( "IMAGE_XSIZE",			"6144"		)
epicsEnvSet( "IMAGE_YSIZE",			"6144"		)
epicsEnvSet( "IMAGE_COLORMODE",	        	"0"		)	# 0=Mono,1=Bayer,2=RGB
epicsEnvSet( "IMAGE_NELM",			"37748736"	)	# X*Y (B/W) or X*Y*3 (Color)
epicsEnvSet( "RESOLUTION",			"10"		)
epicsEnvSet( "RES_EGU",				"um"		)

